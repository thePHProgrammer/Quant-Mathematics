//@version=6
indicator("Trading Context Pack (COT + Volume Profile + Delta)", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ============================================================================
// ONE indicator slot, no Premium/Ultimate required. Combines three things:
//   1. Weekly COT positioning (large speculators) -- futures symbols only.
//   2. A fixed-lookback Volume Profile histogram (POC / Value Area), built from
//      each bar's own high/low/volume, since real footprint data needs Premium/Ultimate.
//   3. An approximate cumulative delta from lower-timeframe volume.
// Results show as a small table (top-right), a histogram bar per price bin on the
// left of the profile window, and full-width highlighted POC/VAH/VAL bands --
// similar in spirit to public tools like ChartPrime's Filtered Volume Profile,
// built independently here since that one's a separate paid script, not something
// to copy.
//
// HONESTY NOTE: I have no way to compile-test Pine Script myself. Built carefully
// from documented Pine features, but if the Editor throws a compile error, paste
// it back with the line number and I'll fix that specific line.
// ============================================================================

import TradingView/LibraryCOT/6 as cot

// ============================= INPUTS =============================
// -- COT --
bool   enableCOT      = input.bool(true, "COT: enable (turn OFF on spot/CFD symbols like XAUUSD, EURUSD)", group = "COT")
string cftcOverride   = input.string("", "COT: manual CFTC code (blank = auto)", group = "COT")
string reportType     = input.string("Legacy", "COT: report type", options = ["Legacy", "Disaggregated", "Financial"], group = "COT")
bool   includeOptions = input.bool(false, "COT: include options data", group = "COT")
string longMetric     = input.string("Noncommercial Positions", "COT: metric name", tooltip = "Confirmed against TradingView's own COT indicator docs. 'Noncommercial Positions' = large speculators' actual position size in contracts. Swap to 'Commercial Positions' to track hedgers instead.", group = "COT")
int    cotLookback    = input.int(156, "COT: extremes lookback (bars)", minval = 20, tooltip = "156 weekly bars ~= 3 years, used to flag positioning extremes.", group = "COT")

// -- Volume Profile (fixed-lookback histogram) --
bool   showVP           = input.bool(true, "Volume Profile: show", group = "Volume Profile")
int    profileLookback  = input.int(200, "Volume Profile: lookback (bars)", minval = 20, maxval = 2000, tooltip = "How many recent bars the profile is built from -- a rolling window, not a session reset. Large values may slow the chart down.", group = "Volume Profile")
int    profileWidthBars = input.int(30, "Volume Profile: max bar width (bars)", minval = 5, maxval = 200, tooltip = "How wide the single biggest bin's bar is drawn, in bars. Other bins scale relative to it.", group = "Volume Profile")
bool   autoBinSize     = input.bool(true, "Volume Profile: auto-size bins to instrument", tooltip = "Sizes bins from this instrument's own daily ATR, so you don't have to manually re-tune this every time you switch symbols (EURUSD vs XAUUSD vs an index). Turn off to set a fixed bin size yourself.", group = "Volume Profile")
int    autoBinRows     = input.int(40, "Volume Profile: auto bin target rows", minval = 10, maxval = 200, tooltip = "Roughly how many bins to divide the lookback range into. More rows = finer profile, fewer = coarser. Only used when auto-size is on.", group = "Volume Profile")
float  manualRowSize   = input.float(0.0005, "Volume Profile: manual bin size (price units)", minval = 0.00001, step = 0.0001, tooltip = "Only used when auto-size is off, e.g. 0.0005 for EURUSD, 5-10 for gold/indices.", group = "Volume Profile")
int    vaPercent       = input.int(70, "Volume Profile: Value Area %", minval = 1, maxval = 99, group = "Volume Profile")

// -- Delta (approximation) --
string lowerTfDelta      = input.timeframe("1", "Delta: lower timeframe", group = "Delta")
bool   resetSessionDelta = input.bool(true, "Delta: reset cumulative each session", group = "Delta")

// -- FVG (Fair Value Gap) --
bool  showFVG      = input.bool(false, "FVG: show (legacy chart-only)", tooltip = "Superseded by the MTF Engine chart-TF layer, which keeps zones until invalidated instead of deleting them on first fill. Kept for comparison.", group = "FVG")
int   fvgBoxWidth  = input.int(10, "FVG: box width (bars)", minval = 1, maxval = 200, tooltip = "Fixed width for each gap box, like a standard FVG indicator -- it does not keep stretching forward until filled.", group = "FVG")
int   maxFVGBoxes  = input.int(20, "FVG: max active gaps shown per side", minval = 1, maxval = 100, tooltip = "Oldest unfilled gap is dropped once this is exceeded.", group = "FVG")
color fvgBullColor = input.color(color.new(color.green, 70), "FVG: bullish color", group = "FVG")
color fvgBearColor = input.color(color.new(color.red, 70), "FVG: bearish color", group = "FVG")

// -- Supply/Demand (swing-based) --
bool showSD     = input.bool(true, "Supply/Demand: show", group = "Supply/Demand")
int  pivotLen   = input.int(5, "Supply/Demand: pivot strength (bars each side)", minval = 1, maxval = 50, tooltip = "Higher = fewer, more significant swing points. A pivot only confirms this many bars after it happens (normal lag for any swing detector).", group = "Supply/Demand")
int  maxSDZones = input.int(10, "Supply/Demand: max zones per side", minval = 1, maxval = 50, group = "Supply/Demand")

// -- Order Block --
bool  showOB           = input.bool(false, "Order Block: show (legacy chart-only)", tooltip = "Superseded by the MTF Engine chart-TF layer (OB requires a BOS, kept until invalidated). Kept for comparison.", group = "Order Block")
int   obBoxWidth       = input.int(15, "Order Block: box width (bars)", minval = 1, maxval = 200, tooltip = "Fixed width, same idea as FVG width -- doesn't stretch forward until mitigated.", group = "Order Block")
float obImpulseAtrMult = input.float(1.5, "Order Block: impulse strength (x ATR)", minval = 0.5, step = 0.1, tooltip = "How much bigger than a typical recent candle the breakout candle must be to count as impulsive.", group = "Order Block")
int   maxOBBoxes       = input.int(15, "Order Block: max active blocks per side", minval = 1, maxval = 50, group = "Order Block")
color obColor          = input.color(color.new(color.orange, 75), "Order Block: color", group = "Order Block")

// -- Market Structure (BOS/CHoCH) --
bool  showMS        = input.bool(true, "Market Structure: show", group = "Market Structure")
int   msPivotLen    = input.int(5, "Market Structure: pivot strength (bars each side)", minval = 1, maxval = 50, group = "Market Structure")
int   maxMSMarkers  = input.int(30, "Market Structure: max markers shown", minval = 1, maxval = 100, tooltip = "Oldest BOS/CHoCH marker is dropped once this is exceeded.", group = "Market Structure")
color bosColor      = input.color(color.new(color.gray, 30), "Market Structure: BOS color", group = "Market Structure")
color chochColor    = input.color(color.new(color.orange, 20), "Market Structure: CHoCH color", group = "Market Structure")

// -- Kill Zones --
bool   showKZ         = input.bool(true, "Kill Zones: show", group = "Kill Zones")
string londonKZSession = input.session("0200-0500", "London Kill Zone (EST)", group = "Kill Zones")
string nyAmKZSession   = input.session("0830-1100", "NY AM Kill Zone (EST)", group = "Kill Zones")
string nyPmKZSession   = input.session("1330-1600", "NY PM Kill Zone (EST)", group = "Kill Zones")

// -- SMT Divergence --
bool   showSMT      = input.bool(true, "SMT: show", group = "SMT")
string smtSymbol    = input.symbol("", "SMT: correlated symbol (blank = off)", tooltip = "e.g. FX:GBPUSD if charting EURUSD, or CME_MINI:NQ1! if charting CME_MINI:ES1!. Needs a genuinely correlated instrument on the same timeframe -- leave blank to disable.", group = "SMT")
int    smtPivotLen  = input.int(5, "SMT: pivot strength (bars each side)", minval = 1, maxval = 50, group = "SMT")
int    maxSMTLabels = input.int(20, "SMT: max markers shown", minval = 1, maxval = 100, group = "SMT")

// -- CISD (Change in State of Delivery) --
// Body-close test, distinct from the swing-based CHoCH above: the level is the OPEN of the
// first candle in the most recent run of same-direction candles, and it confirms on a full
// BODY close through that level (a wick alone doesn't count) -- so CISD typically fires
// earlier than a CHoCH, and more often, since it doesn't wait for an actual swing break.
bool  showCISD       = input.bool(true, "CISD: show", group = "CISD")
int   maxCISDMarkers = input.int(20, "CISD: max markers shown", minval = 1, maxval = 100, group = "CISD")
color cisdBullColor  = input.color(color.new(color.aqua, 20), "CISD: bullish color", group = "CISD")
color cisdBearColor  = input.color(color.new(color.maroon, 20), "CISD: bearish color", group = "CISD")

// -- Low Resistance Liquidity (approximate score) --
// HONEST CAVEAT: this is NOT a mechanical ICT definition -- there isn't one. It's a proxy:
// counting how many of your own currently-active Supply/Demand zones (from the section
// below) sit between current price and each direction. Fewer zones in the way = "low
// resistance" reading; more = "high resistance." Treat it as a rough filter, not a signal.
bool showLRL = input.bool(true, "Low Resistance Liquidity: show (approx.)", group = "Low Resistance Liquidity")

// ============================= COT =============================
// Futures symbols only (e.g. CME_MINI:6E1!, CME:6B1!, COMEX:GC1! for gold futures).
// getCFTCCode() RAISES A RUNTIME ERROR -- which halts the entire script, every section,
// not just this one -- if the chart symbol isn't a recognized futures instrument. Spot/CFD
// symbols like XAUUSD or EURUSD will trip that, so it's gated behind "COT: enable":
// leave it OFF on a spot/CFD chart, turn it ON only when charting the actual futures
// contract (e.g. switch XAUUSD to COMEX:GC1! or COMEX_MINI:MGC1! to get gold's COT data).
float cotNet   = na
float cotIndex = na
if enableCOT
    string cftcCode = cftcOverride != "" ? cftcOverride : cot.getCFTCCode(syminfo.tickerid)
    float specLong  = cot.requestCommitmentOfTraders(reportType, cftcCode, includeOptions, longMetric, "Long", "All")
    float specShort = cot.requestCommitmentOfTraders(reportType, cftcCode, includeOptions, longMetric, "Short", "All")
    cotNet := specLong - specShort
    float cotHi = ta.highest(cotNet, cotLookback)
    float cotLo = ta.lowest(cotNet, cotLookback)
    cotIndex := cotHi != cotLo ? (cotNet - cotLo) / (cotHi - cotLo) * 100 : na

// ============================= VOLUME PROFILE (fixed-lookback histogram) =============================
// Distributes each bar's volume across every price bin its high-to-low range spans
// (not just its close), then redraws the whole histogram fresh on the last bar only --
// old boxes/labels are deleted first so they don't pile up past Pine's drawing limits.
float dailyATR         = request.security(syminfo.tickerid, "D", ta.atr(14))
float effectiveRowSize = autoBinSize ? math.max(dailyATR / autoBinRows, syminfo.mintick * 2) : manualRowSize

var array<box> vpBoxes = array.new_box()
var box   pocBand  = na
var box   vahBand  = na
var box   valBand  = na
var label pocLabel = na
var label vahLabel = na
var label valLabel = na

var float pocPriceOut = na
var float vahPriceOut = na
var float valPriceOut = na
var float pocVolOut   = na

if barstate.islast
    for b in vpBoxes
        box.delete(b)
    array.clear(vpBoxes)
    if not na(pocBand)
        box.delete(pocBand)
        pocBand := na
    if not na(vahBand)
        box.delete(vahBand)
        vahBand := na
    if not na(valBand)
        box.delete(valBand)
        valBand := na
    if not na(pocLabel)
        label.delete(pocLabel)
        pocLabel := na
    if not na(vahLabel)
        label.delete(vahLabel)
        vahLabel := na
    if not na(valLabel)
        label.delete(valLabel)
        valLabel := na

    if not showVP
        pocPriceOut := na
        vahPriceOut := na
        valPriceOut := na
        pocVolOut   := na

    if showVP
        map<int, float> hist = map.new<int, float>()
        int lastIdx = math.min(profileLookback - 1, bar_index)
        for i = 0 to lastIdx
            float hi  = high[i]
            float lo  = low[i]
            float vol = volume[i]
            int kHi = int(math.round(hi / effectiveRowSize))
            int kLo = int(math.round(lo / effectiveRowSize))
            int span = kHi - kLo + 1
            float volPerBin = vol / span
            for k = kLo to kHi
                float existing = map.contains(hist, k) ? map.get(hist, k) : 0.0
                map.put(hist, k, existing + volPerBin)

        if map.size(hist) > 0
            array<int>   hKeys = map.keys(hist)
            array<float> hVals = map.values(hist)
            int hn = array.size(hKeys)

            // Point of Control: the single bin with the most volume.
            float maxVol = -1.0
            int   pocKey = na
            for i = 0 to hn - 1
                float v = array.get(hVals, i)
                if v > maxVol
                    maxVol := v
                    pocKey := array.get(hKeys, i)

            // Value Area: expand outward from the POC, one bin at a time, always taking
            // whichever adjacent side has more volume, until vaPercent of total volume
            // is covered.
            float totalVol = array.sum(hVals)
            float target   = totalVol * (vaPercent / 100.0)
            int   vaHiKey  = pocKey
            int   vaLoKey  = pocKey
            float accumulated = maxVol
            bool  canExpand   = true
            while accumulated < target and canExpand
                int  upKey = vaHiKey + 1
                int  dnKey = vaLoKey - 1
                bool hasUp = map.contains(hist, upKey)
                bool hasDn = map.contains(hist, dnKey)
                if not hasUp and not hasDn
                    canExpand := false
                else
                    float upVol = hasUp ? map.get(hist, upKey) : -1.0
                    float dnVol = hasDn ? map.get(hist, dnKey) : -1.0
                    if upVol >= dnVol
                        vaHiKey := upKey
                        accumulated += upVol
                    else
                        vaLoKey := dnKey
                        accumulated += dnVol

            int leftAnchor = bar_index - lastIdx

            // Draw the histogram: one box per bin, width proportional to that bin's volume.
            for i = 0 to hn - 1
                int   k = array.get(hKeys, i)
                float v = array.get(hVals, i)
                float widthBars = math.max((v / maxVol) * profileWidthBars, 1)
                bool  inVA  = k >= vaLoKey and k <= vaHiKey
                bool  isPoc = k == pocKey
                color boxColor = isPoc ? color.new(color.orange, 20) : inVA ? color.new(color.blue, 55) : color.new(color.gray, 80)
                box newBox = box.new(left = leftAnchor, top = (k + 0.5) * effectiveRowSize, right = leftAnchor + int(math.round(widthBars)), bottom = (k - 0.5) * effectiveRowSize, bgcolor = boxColor, border_width = 0)
                array.push(vpBoxes, newBox)

            // Full-width highlighted bands for POC / VAH / VAL, like support-resistance zones.
            float pocTop = (pocKey + 0.5) * effectiveRowSize
            float pocBot = (pocKey - 0.5) * effectiveRowSize
            pocBand  := box.new(left = leftAnchor, top = pocTop, right = bar_index + 500, bottom = pocBot, bgcolor = color.new(color.orange, 75), border_width = 0)
            pocLabel := label.new(bar_index, pocTop, "POC  " + str.tostring(maxVol, format.volume), style = label.style_label_left, color = color.orange, textcolor = color.white, size = size.small)

            float vahTop = (vaHiKey + 0.5) * effectiveRowSize
            float vahBot = (vaHiKey - 0.5) * effectiveRowSize
            vahBand  := box.new(left = leftAnchor, top = vahTop, right = bar_index + 500, bottom = vahBot, bgcolor = color.new(color.blue, 80), border_width = 0)
            vahLabel := label.new(bar_index, vahTop, "VAH", style = label.style_label_left, color = color.blue, textcolor = color.white, size = size.small)

            float valTop = (vaLoKey + 0.5) * effectiveRowSize
            float valBot = (vaLoKey - 0.5) * effectiveRowSize
            valBand  := box.new(left = leftAnchor, top = valTop, right = bar_index + 500, bottom = valBot, bgcolor = color.new(color.purple, 80), border_width = 0)
            valLabel := label.new(bar_index, valTop, "VAL", style = label.style_label_left, color = color.purple, textcolor = color.white, size = size.small)

            pocPriceOut := (pocTop + pocBot) / 2
            vahPriceOut := vahTop
            valPriceOut := valBot
            pocVolOut   := maxVol

// ============================= MARKET STRUCTURE (BOS/CHoCH) =============================
// Tracks the most recent confirmed swing high/low and labels each break: breaking in the
// direction of the current trend = BOS (continuation), breaking AGAINST it = CHoCH
// (reversal, flips the tracked trend). Distinct from your CISD -- this is the formal
// swing-break vocabulary most other ICT tools expect. Runs every bar (not just the last)
// so it displays correctly through history. Capped and shifted like FVG/OB above.
float msPH = ta.pivothigh(msPivotLen, msPivotLen)
float msPL = ta.pivotlow(msPivotLen, msPivotLen)

var float msSwingHigh    = na
var float msSwingLow     = na
var int   msSwingHighBar = na
var int   msSwingLowBar  = na
var int   msTrend        = 0  // 1 = up, -1 = down, 0 = undefined (no break yet)

var array<line>  msLines  = array.new_line()
var array<label> msLabels = array.new_label()

if showMS
    if not na(msPH)
        msSwingHigh    := msPH
        msSwingHighBar := bar_index - msPivotLen
    if not na(msPL)
        msSwingLow    := msPL
        msSwingLowBar := bar_index - msPivotLen

    if not na(msSwingHigh) and close > msSwingHigh
        string tag = msTrend == -1 ? "CHoCH" : "BOS"
        color  col = msTrend == -1 ? chochColor : bosColor
        line  newLine  = line.new(msSwingHighBar, msSwingHigh, bar_index, msSwingHigh, color = col, width = 2)
        label newLabel = label.new(bar_index, msSwingHigh, tag, style = label.style_label_down, color = col, textcolor = color.white, size = size.small)
        array.push(msLines, newLine)
        array.push(msLabels, newLabel)
        if array.size(msLines) > maxMSMarkers
            line.delete(array.shift(msLines))
            label.delete(array.shift(msLabels))
        msTrend     := 1
        msSwingHigh := na

    if not na(msSwingLow) and close < msSwingLow
        string tag = msTrend == 1 ? "CHoCH" : "BOS"
        color  col = msTrend == 1 ? chochColor : bosColor
        line  newLine  = line.new(msSwingLowBar, msSwingLow, bar_index, msSwingLow, color = col, width = 2)
        label newLabel = label.new(bar_index, msSwingLow, tag, style = label.style_label_up, color = col, textcolor = color.white, size = size.small)
        array.push(msLines, newLine)
        array.push(msLabels, newLabel)
        if array.size(msLines) > maxMSMarkers
            line.delete(array.shift(msLines))
            label.delete(array.shift(msLabels))
        msTrend    := -1
        msSwingLow := na

// ============================= KILL ZONES =============================
// Session-time highlighting only -- no drawing objects, just a background tint, so this
// adds no clutter risk regardless of how long the chart history is.
bool inLondonKZ = not na(time(timeframe.period, londonKZSession + ":1234567", "America/New_York"))
bool inNyAmKZ   = not na(time(timeframe.period, nyAmKZSession + ":1234567", "America/New_York"))
bool inNyPmKZ   = not na(time(timeframe.period, nyPmKZSession + ":1234567", "America/New_York"))
color kzColor   = inLondonKZ ? color.new(color.blue, 92) : inNyAmKZ ? color.new(color.orange, 92) : inNyPmKZ ? color.new(color.purple, 92) : na
bgcolor(showKZ ? kzColor : na, title = "Kill Zone highlight")

// ============================= SMT DIVERGENCE =============================
// Compares swing points on THIS chart against a correlated symbol you provide. A bearish
// SMT prints when this chart makes a higher high but the correlated symbol fails to; a
// bullish SMT is the mirror at swing lows. HONEST CAVEAT: this isn't a standalone signal
// even in ICT's own teaching -- it's meant to be read as confluence at a level you already
// care about, and it's only meaningful while the two symbols are actually correlated,
// which drifts over time. Requires a symbol in "SMT: correlated symbol" to do anything.
float smtPH = ta.pivothigh(smtPivotLen, smtPivotLen)
float smtPL = ta.pivotlow(smtPivotLen, smtPivotLen)
// Always call request.security() with a guaranteed-valid symbol -- falls back to this
// chart's own symbol when blank (a harmless self-comparison that never flags a divergence)
// rather than conditionally calling request.security() itself, which risks erroring on an
// empty string if Pine evaluates both sides of the ternary below it.
string smtSymbolSafe = smtSymbol != "" ? smtSymbol : syminfo.tickerid
[corPH, corPL] = request.security(smtSymbolSafe, timeframe.period, [ta.pivothigh(smtPivotLen, smtPivotLen), ta.pivotlow(smtPivotLen, smtPivotLen)])

var float myHighPrev  = na
var float myHighCurr  = na
var float corHighPrev = na
var float corHighCurr = na
var float myLowPrev   = na
var float myLowCurr   = na
var float corLowPrev  = na
var float corLowCurr  = na

var array<label> smtLabels = array.new_label()

if not na(smtPH)
    myHighPrev := myHighCurr
    myHighCurr := smtPH
if not na(corPH)
    corHighPrev := corHighCurr
    corHighCurr := corPH
if not na(smtPL)
    myLowPrev := myLowCurr
    myLowCurr := smtPL
if not na(corPL)
    corLowPrev := corLowCurr
    corLowCurr := corPL

if showSMT and smtSymbol != ""
    if not na(smtPH) and not na(myHighPrev) and not na(corHighCurr) and not na(corHighPrev)
        if myHighCurr > myHighPrev and corHighCurr < corHighPrev
            label newLabel = label.new(bar_index - smtPivotLen, myHighCurr, "SMT-", style = label.style_label_down, color = color.new(color.red, 20), textcolor = color.white, size = size.small)
            array.push(smtLabels, newLabel)
            if array.size(smtLabels) > maxSMTLabels
                label.delete(array.shift(smtLabels))

    if not na(smtPL) and not na(myLowPrev) and not na(corLowCurr) and not na(corLowPrev)
        if myLowCurr < myLowPrev and corLowCurr > corLowPrev
            label newLabel = label.new(bar_index - smtPivotLen, myLowCurr, "SMT+", style = label.style_label_up, color = color.new(color.green, 20), textcolor = color.white, size = size.small)
            array.push(smtLabels, newLabel)
            if array.size(smtLabels) > maxSMTLabels
                label.delete(array.shift(smtLabels))

// ============================= CISD (Change in State of Delivery) =============================
// Tracks runs of consecutive same-direction (body) candles. When a NEW run starts, its
// first candle's OPEN becomes a pending level for the opposite direction: the open of a
// fresh down-run is watched for a bullish CISD (body close back above it); the open of a
// fresh up-run is watched for a bearish CISD (body close back below it). Confirms once,
// then the level is consumed -- it doesn't keep re-triggering while price stays beyond it.
var float cisdDownLegOpen    = na
var float cisdUpLegOpen      = na
var int   cisdDownLegOpenBar = na
var int   cisdUpLegOpenBar   = na
var int   cisdDirState       = 0  // 0 = undefined (no candle yet), 1 = up, -1 = down

var array<line>  cisdLines  = array.new_line()
var array<label> cisdLabels = array.new_label()
var string cisdLastOut = "n/a"

bool cisdIsUpClose   = close > open
bool cisdIsDownClose = close < open

// A new run starts when direction differs from the previous non-flat candle.
if cisdIsDownClose and cisdDirState != -1
    cisdDownLegOpen    := open
    cisdDownLegOpenBar := bar_index
if cisdIsUpClose and cisdDirState != 1
    cisdUpLegOpen    := open
    cisdUpLegOpenBar := bar_index
if cisdIsUpClose
    cisdDirState := 1
if cisdIsDownClose
    cisdDirState := -1

if showCISD
    if not na(cisdDownLegOpen) and close > cisdDownLegOpen
        line  newLine  = line.new(cisdDownLegOpenBar, cisdDownLegOpen, bar_index, cisdDownLegOpen, color = cisdBullColor, width = 2, style = line.style_dashed)
        label newLabel = label.new(bar_index, cisdDownLegOpen, "CISD", style = label.style_label_up, color = cisdBullColor, textcolor = color.white, size = size.small)
        array.push(cisdLines, newLine)
        array.push(cisdLabels, newLabel)
        if array.size(cisdLines) > maxCISDMarkers
            line.delete(array.shift(cisdLines))
            label.delete(array.shift(cisdLabels))
        cisdDownLegOpen := na
        cisdLastOut := "Bullish"

    if not na(cisdUpLegOpen) and close < cisdUpLegOpen
        line  newLine  = line.new(cisdUpLegOpenBar, cisdUpLegOpen, bar_index, cisdUpLegOpen, color = cisdBearColor, width = 2, style = line.style_dashed)
        label newLabel = label.new(bar_index, cisdUpLegOpen, "CISD", style = label.style_label_down, color = cisdBearColor, textcolor = color.white, size = size.small)
        array.push(cisdLines, newLine)
        array.push(cisdLabels, newLabel)
        if array.size(cisdLines) > maxCISDMarkers
            line.delete(array.shift(cisdLines))
            label.delete(array.shift(cisdLabels))
        cisdUpLegOpen := na
        cisdLastOut := "Bearish"

// ============================= FVG (Fair Value Gap) =============================
// Standard 3-candle definition: a gap between candle 1's high/low and candle 3's
// low/high, with candle 2 as the impulse that created it. Runs every bar (not just
// the last one) so gaps display correctly as you scroll back through history.
// Each box is a FIXED width (fvgBoxWidth bars) set once at creation -- it does not
// stretch forward every bar -- matching how standard FVG indicators draw them.
// A gap is deleted outright (not just dimmed) the first time price trades back
// into it at all, so filled gaps don't pile up and overlap other drawings.
var array<box>   bullFvgBoxes  = array.new_box()
var array<label> bullFvgLabels = array.new_label()
var array<box>   bearFvgBoxes  = array.new_box()
var array<label> bearFvgLabels = array.new_label()
var int bullFvgCount = 0
var int bearFvgCount = 0

if showFVG
    // Fill-check existing gaps first (iterate backward -- safe to remove while looping this way).
    if array.size(bullFvgBoxes) > 0
        for i = array.size(bullFvgBoxes) - 1 to 0
            box b   = array.get(bullFvgBoxes, i)
            float bot = box.get_bottom(b)
            if low <= bot
                box.delete(b)
                label.delete(array.get(bullFvgLabels, i))
                array.remove(bullFvgBoxes, i)
                array.remove(bullFvgLabels, i)

    if array.size(bearFvgBoxes) > 0
        for i = array.size(bearFvgBoxes) - 1 to 0
            box b   = array.get(bearFvgBoxes, i)
            float top = box.get_top(b)
            if high >= top
                box.delete(b)
                label.delete(array.get(bearFvgLabels, i))
                array.remove(bearFvgBoxes, i)
                array.remove(bearFvgLabels, i)

    // Detect a new gap confirmed on this bar (candle 3 = current bar).
    bool bullFVG = low > high[2]
    bool bearFVG = high < low[2]

    if bullFVG
        box   newBox   = box.new(left = bar_index - 1, top = low, right = bar_index - 1 + fvgBoxWidth, bottom = high[2], bgcolor = fvgBullColor, border_width = 1, border_color = color.new(color.green, 30))
        label newLabel = label.new(bar_index - 1, high[2], "FVG", style = label.style_label_up, color = color.new(color.green, 30), textcolor = color.white, size = size.tiny)
        array.push(bullFvgBoxes, newBox)
        array.push(bullFvgLabels, newLabel)
        if array.size(bullFvgBoxes) > maxFVGBoxes
            box.delete(array.shift(bullFvgBoxes))
            label.delete(array.shift(bullFvgLabels))

    if bearFVG
        box   newBox   = box.new(left = bar_index - 1, top = low[2], right = bar_index - 1 + fvgBoxWidth, bottom = high, bgcolor = fvgBearColor, border_width = 1, border_color = color.new(color.red, 30))
        label newLabel = label.new(bar_index - 1, low[2], "FVG", style = label.style_label_down, color = color.new(color.red, 30), textcolor = color.white, size = size.tiny)
        array.push(bearFvgBoxes, newBox)
        array.push(bearFvgLabels, newLabel)
        if array.size(bearFvgBoxes) > maxFVGBoxes
            box.delete(array.shift(bearFvgBoxes))
            label.delete(array.shift(bearFvgLabels))

    bullFvgCount := array.size(bullFvgBoxes)
    bearFvgCount := array.size(bearFvgBoxes)


// ============================= SUPPLY / DEMAND (swing-based) =============================
// Supply = resistance zone anchored at a confirmed swing high. Demand = support zone
// anchored at a confirmed swing low. Still extends right each bar while active (this
// one you didn't ask to change) -- but once broken, the zone is deleted outright rather
// than left behind dimmed, so old zones don't pile up and overlap newer ones. Broken =
// price CLOSES through it; wicks alone don't break it, unlike the FVG fill rule above,
// since a zone should tolerate a wick poke the way a gap shouldn't.
// A new zone is skipped entirely if its price range overlaps an existing zone of the
// SAME type (supply-vs-supply, demand-vs-demand) -- that's what was stacking up.
overlapsExisting(array<box> zones, float top, float bottom) =>
    bool found = false
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            box b = array.get(zones, i)
            float bTop = box.get_top(b)
            float bBot = box.get_bottom(b)
            if bottom <= bTop and bBot <= top
                found := true
    found

var array<box>   supplyZones  = array.new_box()
var array<label> supplyLabels = array.new_label()
var array<box>   demandZones  = array.new_box()
var array<label> demandLabels = array.new_label()
var int supplyCount = 0
var int demandCount = 0

// Pivots are computed on every bar (outside the `if`) so their history is consistent even if
// the section is toggled -- ta.* calls inside a conditional block only see the bars it ran on.
float sdPH = ta.pivothigh(pivotLen, pivotLen)
float sdPL = ta.pivotlow(pivotLen, pivotLen)

if showSD
    if array.size(supplyZones) > 0
        for i = array.size(supplyZones) - 1 to 0
            box b = array.get(supplyZones, i)
            float top = box.get_top(b)
            if close > top
                box.delete(b)
                label.delete(array.get(supplyLabels, i))
                array.remove(supplyZones, i)
                array.remove(supplyLabels, i)
            else
                box.set_right(b, bar_index)

    if array.size(demandZones) > 0
        for i = array.size(demandZones) - 1 to 0
            box b = array.get(demandZones, i)
            float bot = box.get_bottom(b)
            if close < bot
                box.delete(b)
                label.delete(array.get(demandLabels, i))
                array.remove(demandZones, i)
                array.remove(demandLabels, i)
            else
                box.set_right(b, bar_index)

    if not na(sdPH)
        float newTop = sdPH
        float newBot = sdPH - effectiveRowSize
        if not overlapsExisting(supplyZones, newTop, newBot)
            int pivotBarIdx = bar_index - pivotLen
            box   newBox   = box.new(left = pivotBarIdx, top = newTop, right = bar_index, bottom = newBot, bgcolor = color.new(color.red, 82), border_width = 1, border_color = color.new(color.red, 40))
            label newLabel = label.new(bar_index, newTop, "Supply", style = label.style_label_down, color = color.new(color.red, 30), textcolor = color.white, size = size.tiny)
            array.push(supplyZones, newBox)
            array.push(supplyLabels, newLabel)
            if array.size(supplyZones) > maxSDZones
                box.delete(array.shift(supplyZones))
                label.delete(array.shift(supplyLabels))

    if not na(sdPL)
        float newTop = sdPL + effectiveRowSize
        float newBot = sdPL
        if not overlapsExisting(demandZones, newTop, newBot)
            int pivotBarIdx = bar_index - pivotLen
            box   newBox   = box.new(left = pivotBarIdx, top = newTop, right = bar_index, bottom = newBot, bgcolor = color.new(color.green, 82), border_width = 1, border_color = color.new(color.green, 40))
            label newLabel = label.new(bar_index, newBot, "Demand", style = label.style_label_up, color = color.new(color.green, 30), textcolor = color.white, size = size.tiny)
            array.push(demandZones, newBox)
            array.push(demandLabels, newLabel)
            if array.size(demandZones) > maxSDZones
                box.delete(array.shift(demandZones))
                label.delete(array.shift(demandLabels))

    supplyCount := array.size(supplyZones)
    demandCount := array.size(demandZones)

// ============================= LOW RESISTANCE LIQUIDITY (approximate score) =============================
// Not a mechanical ICT definition -- there isn't one to code. This counts how many of the
// Supply/Demand zones tracked in the section above are currently active above price and
// below price separately: fewer zones in the way on a given side reads as a "low
// resistance" path in that direction, more reads as "high resistance." Read it as a rough
// filter on conviction/size, not a signal.
var int obstaclesAbove = 0
var int obstaclesBelow = 0

if showLRL
    int aboveCount = 0
    if array.size(supplyZones) > 0
        for i = 0 to array.size(supplyZones) - 1
            box b = array.get(supplyZones, i)
            if box.get_bottom(b) > close
                aboveCount += 1

    int belowCount = 0
    if array.size(demandZones) > 0
        for i = 0 to array.size(demandZones) - 1
            box b = array.get(demandZones, i)
            if box.get_top(b) < close
                belowCount += 1

    obstaclesAbove := aboveCount
    obstaclesBelow := belowCount

// ============================= ORDER BLOCK =============================
// The last opposing candle before an impulsive break: a bearish candle right before
// a strong bullish breakout marks a bullish (support-like) block, and the mirror image
// marks a bearish (resistance-like) block. "Impulsive" = that breakout candle's range
// exceeds obImpulseAtrMult x this chart's own recent ATR (a different, shorter-period
// ATR than the daily one used for Volume Profile/Supply-Demand sizing, since this needs
// to judge a single candle against recent LOCAL volatility, not a daily range).
// Fixed-width boxes like FVG, deleted outright once mitigated -- but mitigation here is
// first-touch-of-the-near-edge, not the full-fill rule used for FVG, since that's the
// more standard reading of "mitigated" for an order block. Overlap-checked the same way
// Supply/Demand zones are, using the same helper function.
float chartATR      = ta.atr(14)
bool  impulsiveUp   = (close - open) > 0 and (high - low) > obImpulseAtrMult * chartATR
bool  impulsiveDown = (close - open) < 0 and (high - low) > obImpulseAtrMult * chartATR
bool  bullOB = (close[1] - open[1]) < 0 and impulsiveUp
bool  bearOB = (close[1] - open[1]) > 0 and impulsiveDown

var array<box>   bullObBoxes  = array.new_box()
var array<label> bullObLabels = array.new_label()
var array<box>   bearObBoxes  = array.new_box()
var array<label> bearObLabels = array.new_label()
var int bullObCount = 0
var int bearObCount = 0

if showOB
    if array.size(bullObBoxes) > 0
        for i = array.size(bullObBoxes) - 1 to 0
            box b = array.get(bullObBoxes, i)
            float top = box.get_top(b)
            if low <= top
                box.delete(b)
                label.delete(array.get(bullObLabels, i))
                array.remove(bullObBoxes, i)
                array.remove(bullObLabels, i)

    if array.size(bearObBoxes) > 0
        for i = array.size(bearObBoxes) - 1 to 0
            box b = array.get(bearObBoxes, i)
            float bot = box.get_bottom(b)
            if high >= bot
                box.delete(b)
                label.delete(array.get(bearObLabels, i))
                array.remove(bearObBoxes, i)
                array.remove(bearObLabels, i)

    if bullOB
        float newTop = high[1]
        float newBot = low[1]
        if not overlapsExisting(bullObBoxes, newTop, newBot)
            box   newBox   = box.new(left = bar_index - 1, top = newTop, right = bar_index - 1 + obBoxWidth, bottom = newBot, bgcolor = obColor, border_width = 1, border_color = color.new(color.orange, 30))
            label newLabel = label.new(bar_index - 1, newBot, "Order Block", style = label.style_label_up, color = color.new(color.orange, 30), textcolor = color.white, size = size.tiny)
            array.push(bullObBoxes, newBox)
            array.push(bullObLabels, newLabel)
            if array.size(bullObBoxes) > maxOBBoxes
                box.delete(array.shift(bullObBoxes))
                label.delete(array.shift(bullObLabels))

    if bearOB
        float newTop = high[1]
        float newBot = low[1]
        if not overlapsExisting(bearObBoxes, newTop, newBot)
            box   newBox   = box.new(left = bar_index - 1, top = newTop, right = bar_index - 1 + obBoxWidth, bottom = newBot, bgcolor = obColor, border_width = 1, border_color = color.new(color.orange, 30))
            label newLabel = label.new(bar_index - 1, newTop, "Order Block", style = label.style_label_down, color = color.new(color.orange, 30), textcolor = color.white, size = size.tiny)
            array.push(bearObBoxes, newBox)
            array.push(bearObLabels, newLabel)
            if array.size(bearObBoxes) > maxOBBoxes
                box.delete(array.shift(bearObBoxes))
                label.delete(array.shift(bearObLabels))

    bullObCount := array.size(bullObBoxes)
    bearObCount := array.size(bearObBoxes)

// ============================= DELTA (approximation) =============================
var float cumDelta = 0.0
float dayChange = ta.change(time("D"))
bool newSessionDelta = resetSessionDelta and dayChange != 0
if newSessionDelta
    cumDelta := 0.0

[upVol, downVol] = request.security_lower_tf(syminfo.tickerid, lowerTfDelta, [close > open ? volume : 0.0, close < open ? volume : 0.0])
float barDelta = array.sum(upVol) - array.sum(downVol)
if not na(barDelta)
    cumDelta += barDelta

// ==== ENGINE START (keep in sync) ====
// Everything between the ENGINE START/END markers is shared verbatim with mtf_zone_strategy.pine.
// Edit it here, then run `python3 tools/sync_engine.py` to copy it across. Names are prefixed
// (mtf*/Mtf*) so the block never collides with the rest of the indicator. Full rule definitions:
// docs/SPEC.md.

// ============================= MTF ENGINE: INPUTS =============================
string mtfMode     = input.string("Auto", "MTF: timeframe selection", options = ["Auto", "Manual"], tooltip = "Auto picks the higher/lower timeframe from a fixed lookup table based on the chart timeframe (see docs/SPEC.md). Manual uses the two fields below.", group = "MTF Engine")
string mtfLtf1h    = input.string("5", "MTF: Auto LTF on a 1H chart", options = ["5", "15"], tooltip = "5m shows finer entry structure but more noise; 15m is cleaner but coarser.", group = "MTF Engine")
string mtfHtfMan   = input.timeframe("60", "MTF: Manual higher timeframe", group = "MTF Engine")
string mtfLtfMan   = input.timeframe("5", "MTF: Manual lower timeframe", group = "MTF Engine")
bool   mtfShowHtf  = input.bool(true, "Show HTF layer", inline = "lay", group = "MTF Engine")
bool   mtfShowCtf  = input.bool(true, "Chart TF layer", inline = "lay", group = "MTF Engine")
bool   mtfShowLtf  = input.bool(true, "LTF layer", inline = "lay", group = "MTF Engine")
bool   mtfShowDev  = input.bool(false, "Show developing (unconfirmed) HTF zones", tooltip = "Drawn hollow and grey on the last bar only. Never used by setups, scoring or alerts.", group = "MTF Engine")

// ============================= MTF ENGINE: TIMEFRAME LADDER =============================
// Explicit lookup: each chart timeframe maps to the largest table row that is <= it
// ("nearest lower row"). "" means that layer is off for this row.
//   chart:  1m  3m  5m  15m  30m  1H     4H  1D
//   LTF:    --  1m  1m  5m   5m   5/15m  1H  4H
//   HTF:    15m 30m 1H  4H   4H   1D     1W  1M
mtf_ladder(int sec, string ltf1h) =>
    string l = ""
    string h = ""
    if sec < 180
        l := ""
        h := "15"
    else if sec < 300
        l := "1"
        h := "30"
    else if sec < 900
        l := "1"
        h := "60"
    else if sec < 1800
        l := "5"
        h := "240"
    else if sec < 3600
        l := "5"
        h := "240"
    else if sec < 14400
        l := ltf1h
        h := "D"
    else if sec < 86400
        l := "60"
        h := "W"
    else
        l := "240"
        h := "M"
    [l, h]

// Short display name for a timeframe string, e.g. "60" -> "1H", "240" -> "4H", "D" -> "1D".
mtf_tfName(string tf) =>
    int s = timeframe.in_seconds(tf)
    s < 3600 ? str.tostring(math.round(s / 60)) + "m" : s < 86400 ? str.tostring(math.round(s / 3600)) + "H" : s < 604800 ? str.tostring(math.round(s / 86400)) + "D" : s < 2419200 ? str.tostring(math.round(s / 604800)) + "W" : str.tostring(math.round(s / 2628000)) + "M"

int  mtfChartSec  = timeframe.in_seconds(timeframe.period)
// MTF needs a standard, time-based chart: on Renko/Range/Kagi/P&F/Line Break/Heikin Ashi or tick
// charts, OHLC is synthetic or bars aren't time-sliced, so cross-timeframe zones would be wrong.
bool mtfSupported = chart.is_standard and not timeframe.isticks
[mtfAutoL, mtfAutoH] = mtf_ladder(mtfChartSec, mtfLtf1h)
string mtfHtfRaw = mtfMode == "Auto" ? mtfAutoH : mtfHtfMan
string mtfLtfRaw = mtfMode == "Auto" ? mtfAutoL : mtfLtfMan
// A layer is enabled only when it is strictly higher (HTF) / lower (LTF) than the chart.
// A manual setting on the wrong side is disabled with a warning -- never silently swapped.
bool mtfHtfOn = mtfSupported and mtfHtfRaw != "" and timeframe.in_seconds(mtfHtfRaw) > mtfChartSec
bool mtfLtfOn = mtfSupported and mtfLtfRaw != "" and timeframe.in_seconds(mtfLtfRaw) < mtfChartSec
string mtfWarn = not mtfSupported ? "MTF off: needs a standard time-based chart" : mtfHtfRaw != "" and not mtfHtfOn ? "HTF " + mtfHtfRaw + " is not above chart TF -- HTF layer off" : mtfLtfRaw != "" and not mtfLtfOn ? "LTF " + mtfLtfRaw + " is not below chart TF -- LTF layer off" : ""
// Requests always get a valid timeframe: a disabled layer requests the chart TF and is ignored.
string mtfHtfSafe = mtfHtfOn ? mtfHtfRaw : timeframe.period
string mtfLtfSafe = mtfLtfOn ? mtfLtfRaw : timeframe.period
string mtfHtfName = mtfHtfOn ? mtf_tfName(mtfHtfRaw) : "off"
string mtfLtfName = mtfLtfOn ? mtf_tfName(mtfLtfRaw) : "off"
string mtfCtfName = mtf_tfName(timeframe.period)

// ============================= MTF ENGINE: ZONE DEFINITIONS =============================
// These decide WHAT a zone is. They are frozen across every backtest model (A-F); models only
// decide which setups get taken. Changing one of these = a new experiment, not a new model.
float mtfFvgMinAtr  = input.float(0.10, "FVG: minimum gap size (x ATR14)", minval = 0.0, step = 0.05, group = "MTF Zone Definitions")
bool  mtfFvgNeedDsp = input.bool(true, "FVG: middle candle must be a displacement candle", group = "MTF Zone Definitions")
float mtfDispAtr    = input.float(1.2, "Displacement: candle body >= x ATR14 (ATR measured before that candle)", minval = 0.1, step = 0.1, group = "MTF Zone Definitions")
int   mtfObBosBars  = input.int(5, "OB: BOS must follow the displacement within (bars)", minval = 0, maxval = 50, group = "MTF Zone Definitions")
int   mtfPivLen     = input.int(5, "Swing: pivot strength (bars each side)", minval = 1, maxval = 50, tooltip = "A swing is only KNOWN this many bars after it prints. It is drawn at the pivot bar, but every rule uses the confirmation bar.", group = "MTF Zone Definitions")

// ============================= MTF ENGINE: EVENT DETECTOR =============================
// Runs in whatever timeframe context it is called from (chart, HTF via request.security, LTF via
// request.security_lower_tf) and returns only the events that became KNOWN on that bar's close.
// It draws nothing. Each call site keeps its own `var` state.
//   FVG (bull):  low > high[2], gap >= mtfFvgMinAtr*ATR, optional displacement middle candle.
//                Zone = [high[2], low]. Origin (visual) = candle 1 time.
//   OB  (bull):  last down-close candle before a displacement up-candle, kept as a candidate
//                for mtfObBosBars bars; it becomes an OB only when a BOS (close above the last
//                confirmed swing high) happens in that window. Zone = that candle's [low, high].
//   Swing H/L:   ta.pivothigh/low(len, len); value returned on the CONFIRMATION bar, with the
//                pivot bar's time for drawing.
//   Structure:   trend = +1 after a close above the last unbroken confirmed swing high, -1 after a
//                close below the last unbroken confirmed swing low (BOS/CHoCH state).
//   Range:       last confirmed swing high / low (never consumed) = dealing range for P/D, OTE.
mtf_events(simple float dispAtr, simple float fvgMinAtr, simple bool fvgNeedDsp, simple int obBosBars, simple int pivLen) =>
    float atr  = ta.atr(14)
    float vSma = ta.sma(volume, 20)
    float atrPrev  = nz(atr[1], atr)
    float atrPrev2 = nz(atr[2], atrPrev)
    // --- FVG ---
    bool  midDisp = math.abs(close[1] - open[1]) >= dispAtr * atrPrev2
    bool  bullF = low > high[2] and (low - high[2]) >= fvgMinAtr * atr and (not fvgNeedDsp or (midDisp and close[1] > open[1]))
    bool  bearF = high < low[2] and (low[2] - high) >= fvgMinAtr * atr and (not fvgNeedDsp or (midDisp and close[1] < open[1]))
    float bFT = bullF ? low : na
    float bFB = bullF ? high[2] : na
    float sFT = bearF ? low[2] : na
    float sFB = bearF ? high : na
    int   fT  = time[2]
    // --- Swings + structure ---
    float ph = ta.pivothigh(pivLen, pivLen)
    float pl = ta.pivotlow(pivLen, pivLen)
    int   pT = time[pivLen]
    var float swHi  = na
    var float swLo  = na
    var float rgHi  = na
    var float rgLo  = na
    var int   trend = 0
    if not na(ph)
        swHi := ph
        rgHi := ph
    if not na(pl)
        swLo := pl
        rgLo := pl
    bool bosUp = not na(swHi) and close > swHi
    bool bosDn = not na(swLo) and close < swLo
    if bosUp
        trend := 1
        swHi  := na
    if bosDn
        trend := -1
        swLo  := na
    // --- Order blocks ---
    var float lastDnH = na
    var float lastDnL = na
    var int   lastDnT = na
    var float lastDnV = na
    var float lastUpH = na
    var float lastUpL = na
    var int   lastUpT = na
    var float lastUpV = na
    var float cbH = na
    var float cbL = na
    var int   cbT = na
    var float cbV = na
    var int   cbAge = na
    var float csH = na
    var float csL = na
    var int   csT = na
    var float csV = na
    var int   csAge = na
    bool dispUp = close > open and (close - open) >= dispAtr * atrPrev
    bool dispDn = close < open and (open - close) >= dispAtr * atrPrev
    if not na(cbAge)
        cbAge += 1
        if cbAge > obBosBars
            cbAge := na
    if not na(csAge)
        csAge += 1
        if csAge > obBosBars
            csAge := na
    if dispUp and not na(lastDnH)
        cbH := lastDnH
        cbL := lastDnL
        cbT := lastDnT
        cbV := lastDnV
        cbAge := 0
    if dispDn and not na(lastUpH)
        csH := lastUpH
        csL := lastUpL
        csT := lastUpT
        csV := lastUpV
        csAge := 0
    float bOT = na
    float bOB = na
    float bOV = na
    int   bOTm = na
    float sOT = na
    float sOB = na
    float sOV = na
    int   sOTm = na
    if bosUp and not na(cbAge)
        bOT  := cbH
        bOB  := cbL
        bOV  := cbV
        bOTm := cbT
        cbAge := na
    if bosDn and not na(csAge)
        sOT  := csH
        sOB  := csL
        sOV  := csV
        sOTm := csT
        csAge := na
    // The current candle becomes the "last opposite candle" only after it has been used above.
    if close < open
        lastDnH := high
        lastDnL := low
        lastDnT := time
        lastDnV := vSma > 0 ? volume / vSma : na
    if close > open
        lastUpH := high
        lastUpL := low
        lastUpT := time
        lastUpV := vSma > 0 ? volume / vSma : na
    [bFT, bFB, sFT, sFB, fT, bOT, bOB, bOV, bOTm, sOT, sOB, sOV, sOTm, ph, pl, pT, trend, rgHi, rgLo, time]

// Confirmed-only wrapper for HTF requests: every element is offset by one bar INSIDE the
// requested context (a tuple can't be history-indexed from outside). Used with
// lookahead_on, this returns the last CLOSED HTF bar's events on every chart bar -- the
// TradingView-documented non-repainting pattern.
mtf_eventsConfirmed(simple float dispAtr, simple float fvgMinAtr, simple bool fvgNeedDsp, simple int obBosBars, simple int pivLen) =>
    [a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20] = mtf_events(dispAtr, fvgMinAtr, fvgNeedDsp, obBosBars, pivLen)
    [a1[1], a2[1], a3[1], a4[1], a5[1], a6[1], a7[1], a8[1], a9[1], a10[1], a11[1], a12[1], a13[1], a14[1], a15[1], a16[1], a17[1], a18[1], a19[1], a20[1]]

// ============================= MTF ENGINE: DATA REQUESTS =============================
// Chart TF: direct call.
[cBFT, cBFB, cSFT, cSFB, cFT, cBOT, cBOB, cBOV, cBOTm, cSOT, cSOB, cSOV, cSOTm, cPH, cPL, cPT, cTrend, cRgHi, cRgLo, cTm] = mtf_events(mtfDispAtr, mtfFvgMinAtr, mtfFvgNeedDsp, mtfObBosBars, mtfPivLen)
// HTF, confirmed: one request; values change once per closed HTF bar.
[hBFT, hBFB, hSFT, hSFB, hFT, hBOT, hBOB, hBOV, hBOTm, hSOT, hSOB, hSOV, hSOTm, hPH, hPL, hPT, hTrendRaw, hRgHiRaw, hRgLoRaw, hTm] = request.security(syminfo.tickerid, mtfHtfSafe, mtf_eventsConfirmed(mtfDispAtr, mtfFvgMinAtr, mtfFvgNeedDsp, mtfObBosBars, mtfPivLen), lookahead = barmerge.lookahead_on)
// HTF, developing (display only): the still-forming HTF bar. Never used by setups.
[dBFT, dBFB, dSFT, dSFB, dFT, dBOT, dBOB, dBOV, dBOTm, dSOT, dSOB, dSOV, dSOTm, dPH, dPL, dPT, dTrend, dRgHi, dRgLo, dTm] = request.security(syminfo.tickerid, mtfHtfSafe, mtf_events(mtfDispAtr, mtfFvgMinAtr, mtfFvgNeedDsp, mtfObBosBars, mtfPivLen), lookahead = barmerge.lookahead_off)
// LTF: one request; each element is an array with one value per intrabar.
[lBFT, lBFB, lSFT, lSFB, lFT, lBOT, lBOB, lBOV, lBOTm, lSOT, lSOB, lSOV, lSOTm, lPH, lPL, lPT, lTrend, lRgHi, lRgLo, lTm] = request.security_lower_tf(syminfo.tickerid, mtfLtfSafe, mtf_events(mtfDispAtr, mtfFvgMinAtr, mtfFvgNeedDsp, mtfObBosBars, mtfPivLen))

int   mtfHtfTrend = mtfHtfOn ? hTrendRaw : 0
float mtfRgHi     = mtfHtfOn ? hRgHiRaw : na
float mtfRgLo     = mtfHtfOn ? hRgLoRaw : na
int   mtfLtfTrend = mtfLtfOn and array.size(lTrend) > 0 ? array.last(lTrend) : 0

// HTF dedup: the confirmed tuple repeats on every chart bar inside one HTF bar; only the first
// chart bar after an HTF close (new hTm) processes it.
var int mtfLastHtfT = na
bool mtfHtfNew = mtfHtfOn and not na(hTm) and hTm != mtfLastHtfT
// LTF bookkeeping: intrabars are processed strictly in time order and never twice.
var int mtfLastLtfT = 0
var int mtfLtfMissing = 0

// ============================= MTF ENGINE: DISPLAY INPUTS =============================
color mtfBullCol    = input.color(color.new(color.teal, 82), "Bullish zone", inline = "zc", group = "MTF Display")
color mtfBearCol    = input.color(color.new(color.red, 82), "Bearish zone", inline = "zc", group = "MTF Display")
int   mtfMaxZones   = input.int(12, "Max active zones per layer", minval = 1, maxval = 60, tooltip = "Oldest zone is dropped (validity = Dropped) once exceeded.", group = "MTF Display")
bool  mtfShowSwings = input.bool(true, "Show swing high/low lines", group = "MTF Display")
int   mtfMaxSwings  = input.int(6, "Max swing lines per layer", minval = 1, maxval = 30, group = "MTF Display")

// ============================= MTF ENGINE: STATE OBJECTS =============================
// Three independent state machines -- one never implies another:
//   1. Zone VALIDITY   (validity):  Active -> Invalidated (body close beyond far edge) or Dropped
//                                   (trimmed by the cap). Flipped = polarity-flipped IFVG/Breaker
//                                   (Phase 5). Only validity removes a zone.
//   2. Zone INTERACTION (facts):    touchCount, firstTouchTime, ceTouched, deepestPen, filled.
//                                   A touched / CE-hit / filled zone stays valid.
//   3. SETUP lifecycle (MtfSetup):  Armed -> Triggered -> Open -> Closed(TP/SL/TimeExit), or
//                                   Expired / Cancelled / Rejected before a fill.
type MtfZone
    int    id
    float  top
    float  bot
    int    dir
    string kind
    string tf
    int    layer
    int    originTime
    int    confirmTime
    string validity       = "Active"
    int    touchCount     = 0
    int    firstTouchTime = na
    bool   ceTouched      = false
    float  deepestPen     = 0.0
    bool   filled         = false
    bool   inside         = false
    bool   newTouch       = false
    int    setupCount     = 0
    bool   setupLive      = false
    float  relVol         = na
    string lastSetup      = ""
    box    bx             = na
    line   ce             = na
    label  lb             = na

type MtfSwing
    float price
    int   dir
    int   layer
    int   pivotTime
    int   confirmTime
    bool  taken = false
    line  ln    = na
    label lb    = na

type MtfSetup
    int     id
    MtfZone z
    int     dir
    string  state           = "Armed"
    string  reason          = ""
    float   aoiTop
    float   aoiBot
    int     armBar
    int     trigBar         = na
    int     trigTime        = na
    float   trigClose       = na
    float   stop            = na
    float   target          = na
    float   entry           = na
    int     entryBar        = na
    int     entryTime       = na
    float   exitPrice       = na
    int     exitBar         = na
    float   rMult           = na
    float   mae             = 0.0
    float   mfe             = 0.0
    bool    ambiguous       = false
    bool    timeExitPending = false
    bool    counted         = false
    bool    fStruct         = false
    bool    fSweep          = false
    bool    fPD             = false
    bool    fDisp           = false
    bool    fCE             = false
    string  session         = ""

// Layers: 0 = LTF, 1 = chart TF, 2 = HTF.
var array<MtfZone>  mtfZonesL = array.new<MtfZone>()
var array<MtfZone>  mtfZonesC = array.new<MtfZone>()
var array<MtfZone>  mtfZonesH = array.new<MtfZone>()
var array<MtfSwing> mtfSwL    = array.new<MtfSwing>()
var array<MtfSwing> mtfSwC    = array.new<MtfSwing>()
var array<MtfSwing> mtfSwH    = array.new<MtfSwing>()
var array<int>      mtfIdCtr  = array.from(0)

mtf_layerShow(int layer) =>
    layer == 2 ? mtfShowHtf : layer == 1 ? mtfShowCtf : mtfShowLtf

mtf_kill(MtfZone z) =>
    if not na(z.bx)
        box.delete(z.bx)
    if not na(z.ce)
        line.delete(z.ce)
    if not na(z.lb)
        label.delete(z.lb)

// HTF = thick solid border, chart TF = thin solid, LTF = dashed; flipped zones = dotted.
mtf_draw(MtfZone z) =>
    if mtf_layerShow(z.layer)
        bool   isFlip = z.kind == "IFVG" or z.kind == "Breaker"
        color  fillC  = z.dir == 1 ? mtfBullCol : mtfBearCol
        color  edgeC  = color.new(fillC, 20)
        string bStyle = isFlip ? line.style_dotted : z.layer == 0 ? line.style_dashed : line.style_solid
        float  mid    = (z.top + z.bot) / 2
        string txt    = z.tf + " " + z.kind + (str.contains(z.kind, "OB") or z.kind == "Breaker" ? (na(z.relVol) ? "" : " " + str.tostring(z.relVol, "#.#") + "x") : "")
        z.bx := box.new(z.originTime, z.top, time, z.bot, xloc = xloc.bar_time, border_color = edgeC, border_width = z.layer == 2 ? 2 : 1, border_style = bStyle, bgcolor = fillC)
        z.ce := line.new(z.originTime, mid, time, mid, xloc = xloc.bar_time, color = edgeC, style = line.style_dotted, width = 1)
        z.lb := label.new(z.originTime, z.dir == 1 ? z.bot : z.top, txt, xloc = xloc.bar_time, style = z.dir == 1 ? label.style_label_upper_left : label.style_label_lower_left, color = color.new(color.black, 100), textcolor = edgeC, size = size.tiny)

mtf_addZone(array<MtfZone> arr, float top, float bot, int dir, string kind, int layer, string tf, int originT, float relVol) =>
    int nid = array.get(mtfIdCtr, 0) + 1
    array.set(mtfIdCtr, 0, nid)
    MtfZone z = MtfZone.new(id = nid, top = top, bot = bot, dir = dir, kind = kind, tf = tf, layer = layer, originTime = na(originT) ? time : originT, confirmTime = time, relVol = relVol)
    // Price already inside at creation does not count as a touch: a touch needs price to
    // leave and come back (this is also what makes a flipped zone's first touch a "retest").
    z.inside := high >= bot and low <= top
    mtf_draw(z)
    array.push(arr, z)
    if array.size(arr) > mtfMaxZones
        MtfZone old = array.shift(arr)
        old.validity := "Dropped"
        mtf_kill(old)
    z

// Updates interaction facts, then validity, using this (closed) bar. Zones that flip are
// collected first and created after the loop so the array isn't resized mid-iteration.
mtf_updateZones(array<MtfZone> arr, bool flipOn) =>
    array<MtfZone> flips = array.new<MtfZone>()
    int n = array.size(arr)
    if n > 0
        for i = n - 1 to 0
            MtfZone z = array.get(arr, i)
            bool touching = high >= z.bot and low <= z.top
            z.newTouch := touching and not z.inside
            if z.newTouch
                z.touchCount += 1
                if na(z.firstTouchTime)
                    z.firstTouchTime := time
            z.inside := touching
            float mid = (z.top + z.bot) / 2
            if high >= mid and low <= mid
                z.ceTouched := true
            float h = z.top - z.bot
            if touching and h > 0
                float pen = z.dir == 1 ? (z.top - low) / h : (high - z.bot) / h
                z.deepestPen := math.max(z.deepestPen, math.min(pen, 9.99))
            if (z.kind == "FVG" or z.kind == "IFVG") and (z.dir == 1 ? low <= z.bot : high >= z.top)
                z.filled := true
            bool broken = z.dir == 1 ? close < z.bot : close > z.top
            if broken
                z.validity := "Invalidated"
                mtf_kill(z)
                array.remove(arr, i)
                if flipOn and (z.kind == "FVG" or z.kind == "OB")
                    array.push(flips, z)
    if array.size(flips) > 0
        for z in flips
            MtfZone f = mtf_addZone(arr, z.top, z.bot, -z.dir, z.kind == "FVG" ? "IFVG" : "Breaker", z.layer, z.tf, time, z.relVol)
            f.validity := "Flipped"

mtf_addSwing(array<MtfSwing> arr, float price, int dir, int layer, string tf, int pivT) =>
    MtfSwing s = MtfSwing.new(price = price, dir = dir, layer = layer, pivotTime = na(pivT) ? time : pivT, confirmTime = time)
    if mtfShowSwings and mtf_layerShow(layer)
        color c = dir == 1 ? color.new(color.red, 30) : color.new(color.teal, 30)
        s.ln := line.new(s.pivotTime, price, time, price, xloc = xloc.bar_time, color = c, width = layer == 2 ? 2 : 1, style = layer == 0 ? line.style_dashed : line.style_solid)
        s.lb := label.new(s.pivotTime, price, tf + (dir == 1 ? " SH" : " SL"), xloc = xloc.bar_time, style = dir == 1 ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = c, size = size.tiny)
    array.push(arr, s)
    if array.size(arr) > mtfMaxSwings * 2
        MtfSwing o = array.shift(arr)
        if not na(o.ln)
            line.delete(o.ln)
        if not na(o.lb)
            label.delete(o.lb)

// A swing is "taken" when price trades through it (wick); its line freezes and turns dotted.
mtf_updateSwings(array<MtfSwing> arr) =>
    for s in arr
        if not s.taken and (s.dir == 1 ? high > s.price : low < s.price)
            s.taken := true
            if not na(s.ln)
                line.set_x2(s.ln, time)
                line.set_style(s.ln, line.style_dotted)

mtf_ingest(array<MtfZone> zs, array<MtfSwing> sw, int layer, string tf, float bFT, float bFB, float sFT, float sFB, int fT, float bOT, float bOB, float bOV, int bOTm, float sOT, float sOB, float sOV, int sOTm, float ph, float pl, int pT) =>
    if not na(bFT)
        mtf_addZone(zs, bFT, bFB, 1, "FVG", layer, tf, fT, na)
    if not na(sFT)
        mtf_addZone(zs, sFT, sFB, -1, "FVG", layer, tf, fT, na)
    if not na(bOT)
        mtf_addZone(zs, bOT, bOB, 1, "OB", layer, tf, bOTm, bOV)
    if not na(sOT)
        mtf_addZone(zs, sOT, sOB, -1, "OB", layer, tf, sOTm, sOV)
    if not na(ph)
        mtf_addSwing(sw, ph, 1, layer, tf, pT)
    if not na(pl)
        mtf_addSwing(sw, pl, -1, layer, tf, pT)

mtf_extendRight(array<MtfZone> zs, array<MtfSwing> sw) =>
    for z in zs
        if not na(z.bx)
            box.set_right(z.bx, time)
        if not na(z.ce)
            line.set_x2(z.ce, time)
    for s in sw
        if not s.taken and not na(s.ln)
            line.set_x2(s.ln, time)

// ============================= MTF ENGINE: PER-BAR ZONE UPDATE =============================
// All state changes happen on CLOSED bars only, so nothing flickers or repaints in realtime.
bool mtfFlipOn = false

if barstate.isconfirmed
    // 1) existing zones/swings react to this bar
    mtf_updateZones(mtfZonesH, mtfFlipOn)
    mtf_updateZones(mtfZonesC, mtfFlipOn)
    mtf_updateZones(mtfZonesL, mtfFlipOn)
    mtf_updateSwings(mtfSwH)
    mtf_updateSwings(mtfSwC)
    mtf_updateSwings(mtfSwL)
    // 2) new events that became known on this bar
    mtf_ingest(mtfZonesC, mtfSwC, 1, mtfCtfName, cBFT, cBFB, cSFT, cSFB, cFT, cBOT, cBOB, cBOV, cBOTm, cSOT, cSOB, cSOV, cSOTm, cPH, cPL, cPT)
    if mtfHtfNew
        mtfLastHtfT := hTm
        mtf_ingest(mtfZonesH, mtfSwH, 2, mtfHtfName, hBFT, hBFB, hSFT, hSFB, hFT, hBOT, hBOB, hBOV, hBOTm, hSOT, hSOB, hSOV, hSOTm, hPH, hPL, hPT)
    if mtfLtfOn
        int nIntra = array.size(lTm)
        if nIntra == 0
            mtfLtfMissing += 1
        else
            // Gated by barstate.isconfirmed, so every intrabar in the array is closed; the
            // time check stops an intrabar from ever being processed twice.
            for i = 0 to nIntra - 1
                int it = array.get(lTm, i)
                if it > mtfLastLtfT
                    mtfLastLtfT := it
                    mtf_ingest(mtfZonesL, mtfSwL, 0, mtfLtfName, array.get(lBFT, i), array.get(lBFB, i), array.get(lSFT, i), array.get(lSFB, i), array.get(lFT, i), array.get(lBOT, i), array.get(lBOB, i), array.get(lBOV, i), array.get(lBOTm, i), array.get(lSOT, i), array.get(lSOB, i), array.get(lSOV, i), array.get(lSOTm, i), array.get(lPH, i), array.get(lPL, i), array.get(lPT, i))

// Developing HTF zones: hollow grey, last bar only, never stored.
var array<box> mtfDevBoxes = array.new<box>()
if barstate.islast
    for b in mtfDevBoxes
        box.delete(b)
    array.clear(mtfDevBoxes)
    mtf_extendRight(mtfZonesH, mtfSwH)
    mtf_extendRight(mtfZonesC, mtfSwC)
    mtf_extendRight(mtfZonesL, mtfSwL)
    if mtfShowDev and mtfHtfOn
        color devC = color.new(color.gray, 30)
        if not na(dBFT)
            array.push(mtfDevBoxes, box.new(dFT, dBFT, time, dBFB, xloc = xloc.bar_time, border_color = devC, border_style = line.style_dashed, bgcolor = color.new(color.gray, 100), text = mtfHtfName + " FVG (developing)", text_size = size.tiny, text_color = devC))
        if not na(dSFT)
            array.push(mtfDevBoxes, box.new(dFT, dSFT, time, dSFB, xloc = xloc.bar_time, border_color = devC, border_style = line.style_dashed, bgcolor = color.new(color.gray, 100), text = mtfHtfName + " FVG (developing)", text_size = size.tiny, text_color = devC))
        if not na(dBOT)
            array.push(mtfDevBoxes, box.new(dBOTm, dBOT, time, dBOB, xloc = xloc.bar_time, border_color = devC, border_style = line.style_dashed, bgcolor = color.new(color.gray, 100), text = mtfHtfName + " OB (developing)", text_size = size.tiny, text_color = devC))
        if not na(dSOT)
            array.push(mtfDevBoxes, box.new(dSOTm, dSOT, time, dSOB, xloc = xloc.bar_time, border_color = devC, border_style = line.style_dashed, bgcolor = color.new(color.gray, 100), text = mtfHtfName + " OB (developing)", text_size = size.tiny, text_color = devC))

mtf_zoneTxt(MtfZone z) =>
    na(z) ? "none" : "#" + str.tostring(z.id) + " " + z.tf + " " + z.kind + (z.dir == 1 ? " bull" : " bear") + ": " + z.validity + ", touches " + str.tostring(z.touchCount) + (z.ceTouched ? ", CE hit" : "") + (z.filled ? ", filled" : "")

// ============================= MTF ENGINE: AREA OF INTEREST (context, not an entry) =============================
// An AOI only says WHERE to pay attention. It never fires a trade by itself: a setup also needs
// a Trigger (Phase 4) and must pass the Risk gate. Confluence is shown as 4 categories instead
// of a point count, so correlated facts aren't double-counted:
//   L = Location   price is inside the AOI (gate)          + Disc/Prem of the HTF dealing range (info)
//   S = Structure  HTF structure direction == AOI direction (one flag; chart BOS not counted again)
//   T = Trigger    a setup on this AOI has triggered
//   R = Risk       that setup passed the cost-adjusted reward:risk gate
string mtfAoiMode  = input.string("HTF zone", "AOI definition", options = ["HTF zone", "HTF zone ∩ lower-TF zone"], tooltip = "HTF zone: any Active HTF OB/FVG is an AOI. Intersection: only the part of an HTF zone that overlaps an Active same-direction chart-TF or LTF zone. Frozen across models A-F.", group = "MTF Setups")
bool   mtfShowAoi  = input.bool(true, "Show AOI boxes", group = "MTF Setups")
bool   mtfShowPD   = input.bool(true, "Show Premium / Discount of HTF dealing range", group = "MTF Setups")
bool   mtfFlipAOI  = false  // Phase 5 toggle (IFVG/Breaker as AOIs) is wired below

// A zone qualifies as an AOI source if it is an HTF zone that is still valid.
mtf_isAoiZone(MtfZone z, bool flipAoi) =>
    z.validity == "Active" or (flipAoi and z.validity == "Flipped")

// Returns [ok, top, bot] of the AOI built from HTF zone z. In intersection mode, uses the
// largest overlap with any valid same-direction chart-TF or LTF zone.
mtf_aoi(MtfZone z, string mode) =>
    bool  ok  = mode == "HTF zone"
    float top = z.top
    float bot = z.bot
    if not ok
        float best = 0.0
        for k = 0 to 1
            array<MtfZone> src = k == 0 ? mtfZonesC : mtfZonesL
            for o in src
                if o.dir == z.dir and (o.validity == "Active" or o.validity == "Flipped")
                    float t = math.min(z.top, o.top)
                    float b = math.max(z.bot, o.bot)
                    if t > b and t - b > best
                        best := t - b
                        top  := t
                        bot  := b
                        ok   := true
    [ok, top, bot]

float mtfEq = na(mtfRgHi) or na(mtfRgLo) ? na : (mtfRgHi + mtfRgLo) / 2
mtf_pdTxt(float px) =>
    na(mtfEq) ? "P/D n/a" : px < mtfEq ? "Disc" : px > mtfEq ? "Prem" : "EQ"

var array<box>   mtfAoiBoxes = array.new<box>()
var array<box>   mtfPdBoxes  = array.new<box>()
var array<line>  mtfPdLines  = array.new<line>()

mtf_drawAoiAndPD() =>
    for b in mtfAoiBoxes
        box.delete(b)
    array.clear(mtfAoiBoxes)
    for b in mtfPdBoxes
        box.delete(b)
    array.clear(mtfPdBoxes)
    for l in mtfPdLines
        line.delete(l)
    array.clear(mtfPdLines)
    if mtfShowAoi
        for z in mtfZonesH
            if mtf_isAoiZone(z, mtfFlipAOI)
                [ok, aTop, aBot] = mtf_aoi(z, mtfAoiMode)
                if ok
                    bool   inL  = high >= aBot and low <= aTop
                    bool   inS  = mtfHtfTrend == z.dir
                    bool   inT  = z.lastSetup == "Triggered" or z.lastSetup == "Open" or z.lastSetup == "Closed"
                    string rTxt = inT ? "✓" : z.lastSetup == "Rejected:risk" ? "✗" : "–"
                    color  c    = z.dir == 1 ? color.green : color.red
                    string txt  = (z.dir == 1 ? "BUY AOI " : "SELL AOI ") + z.tf + " " + z.kind + " · L" + (inL ? "✓" : "–") + " S" + (inS ? "✓" : "–") + " T" + (inT ? "✓" : "–") + " R" + rTxt + " · " + mtf_pdTxt((aTop + aBot) / 2)
                    array.push(mtfAoiBoxes, box.new(z.originTime, aTop, time, aBot, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(c, 10), border_width = 2, bgcolor = color.new(c, 88), text = txt, text_size = size.small, text_color = color.new(c, 0), text_halign = text.align_right, text_valign = z.dir == 1 ? text.align_bottom : text.align_top))
    if mtfShowPD and not na(mtfEq)
        int leftT = time[math.min(bar_index, 50)]
        array.push(mtfPdBoxes, box.new(leftT, mtfRgHi, time, mtfEq, xloc = xloc.bar_time, extend = extend.right, border_width = 0, bgcolor = color.new(color.red, 94), text = mtfHtfName + " Premium", text_size = size.tiny, text_color = color.new(color.red, 40), text_halign = text.align_left, text_valign = text.align_top))
        array.push(mtfPdBoxes, box.new(leftT, mtfEq, time, mtfRgLo, xloc = xloc.bar_time, extend = extend.right, border_width = 0, bgcolor = color.new(color.green, 94), text = mtfHtfName + " Discount", text_size = size.tiny, text_color = color.new(color.green, 40), text_halign = text.align_left, text_valign = text.align_bottom))
        array.push(mtfPdLines, line.new(leftT, mtfEq, time, mtfEq, xloc = xloc.bar_time, extend = extend.right, color = color.new(color.gray, 30), style = line.style_dotted))


// ============================= MTF ENGINE: TRADE RULES (the testable hypothesis) =============================
// Baseline trigger T0 contains NONE of the features being tested:
//   price enters a valid HTF AOI (new touch) -> the first chart bar (arming bar included) that
//   closes in the trade direction AND beyond the prior bar's extreme (long: close > open and
//   close > high[1]) within the trigger window -> market entry at the NEXT bar's open.
// Only the FIRST T0 in the window is evaluated: if the model's filters or the risk gate reject it,
// the setup ends (Rejected) -- it does not wait for a "better" bar. That keeps every model's
// trades an exact subset of Model A's, so comparisons test the filter and nothing else.
// Stop  = AOI far edge -/+ stopBuf x ATR14 (at trigger). Target = targetR x (trigger close - stop),
// priced at trigger. Both fixed for every model. Time exit after maxHold bars (at next open).
int   mtfTrigWin   = input.int(12, "Trigger window (bars after AOI touch, incl. touch bar)", minval = 1, maxval = 200, group = "MTF Trade Rules")
float mtfStopBuf   = input.float(0.10, "Stop buffer beyond AOI far edge (x ATR14)", minval = 0.0, step = 0.05, group = "MTF Trade Rules")
float mtfTargetR   = input.float(2.0, "Target (R multiple, priced from trigger close)", minval = 0.5, step = 0.25, group = "MTF Trade Rules")
float mtfMinRR     = input.float(1.5, "Risk gate: min reward:risk after costs", minval = 0.0, step = 0.1, group = "MTF Trade Rules")
int   mtfMaxHold   = input.int(48, "Time exit after (bars in trade)", minval = 1, maxval = 2000, group = "MTF Trade Rules")
int   mtfMaxPerZone = input.int(1, "Max setups per AOI zone", minval = 1, maxval = 10, tooltip = "1 = first-touch hypothesis.", group = "MTF Trade Rules")
bool  mtfSessOn    = input.bool(false, "Only arm setups inside session", group = "MTF Trade Rules")
string mtfSessStr  = input.string("0200-0500,0830-1100,1330-1600", "Session (New York time)", tooltip = "Comma-separated ranges. Default = London / NY AM / NY PM kill zones.", group = "MTF Trade Rules")
// Costs used by the risk gate and the R ledger. Keep them EQUAL to the strategy's
// Settings -> Properties (commission %, slippage ticks); Pine cannot read those values.
float mtfSpreadTk  = input.float(0.0, "Cost: spread (ticks, half charged per side)", minval = 0.0, step = 1.0, group = "MTF Costs (ledger)")
float mtfSlipTk    = input.float(2.0, "Cost: slippage (ticks per market/stop fill)", minval = 0.0, step = 1.0, group = "MTF Costs (ledger)")
float mtfCommPct   = input.float(0.01, "Cost: commission (% of price per side)", minval = 0.0, step = 0.005, group = "MTF Costs (ledger)")
// Research window: setups are only ARMED inside it, so stats never mix in- and out-of-sample.
string mtfWinMode  = input.string("All", "Research window", options = ["All", "In-sample", "Out-of-sample"], group = "MTF Research Window")
int    mtfSplitT   = input.time(timestamp("2025-01-01T00:00:00"), "IS / OOS split (OOS starts here)", group = "MTF Research Window")
int    mtfStartT   = input.time(timestamp("2015-01-01T00:00:00"), "Window start", group = "MTF Research Window")
bool   mtfShowTrades = input.bool(true, "Show setup markers and stop/target lines", group = "MTF Setups")

float mtfAtr   = ta.atr(14)
bool  mtfT0Up  = close > open and close > high[1]
bool  mtfT0Dn  = close < open and close < low[1]
bool  mtfInSess = not mtfSessOn or not na(time(timeframe.period, mtfSessStr + ":1234567", "America/New_York"))
bool  mtfInWin = time >= mtfStartT and (mtfWinMode == "All" or (mtfWinMode == "In-sample" ? time < mtfSplitT : time >= mtfSplitT))

mtf_costSide(float px, bool withSlip) =>
    0.5 * mtfSpreadTk * syminfo.mintick + (withSlip ? mtfSlipTk * syminfo.mintick : 0.0) + px * mtfCommPct / 100

// Net R of a fill pair. Limit (TP) exits pay no slippage, matching the broker emulator.
mtf_rMult(MtfSetup s, float exitPx, bool limitExit) =>
    float risk0 = s.dir == 1 ? s.entry - s.stop : s.stop - s.entry
    float cE = mtf_costSide(s.entry, true)
    float cX = mtf_costSide(exitPx, not limitExit)
    risk0 <= 0 ? -1.0 : s.dir == 1 ? ((exitPx - cX) - (s.entry + cE)) / risk0 : ((s.entry - cE) - (exitPx + cX)) / risk0

// New York-time session bucket for stats.
mtf_sessBucket(int t) =>
    int hr = hour(t, "America/New_York")
    hr >= 2 and hr < 8 ? "London" : hr >= 8 and hr < 12 ? "NY AM" : hr >= 12 and hr < 17 ? "NY PM" : "Asia/Other"

type MtfStats
    int   nArmed    = 0
    int   nExpired  = 0
    int   nCancel   = 0
    int   nRejFilt  = 0
    int   nRejRisk  = 0
    int   nRejBusy  = 0
    int   nTrades   = 0
    int   nWins     = 0
    int   nAmbig    = 0
    float sumR      = 0.0
    float grossWin  = 0.0
    float grossLoss = 0.0
    float eqR       = 0.0
    float peakR     = 0.0
    float maxDD     = 0.0
    int   sumHold   = 0
    float sumMae    = 0.0
    float sumMfe    = 0.0
    array<int>   flagN
    array<float> flagR
    array<int>   sessN
    array<float> sessR

var MtfStats mtfSt = MtfStats.new(flagN = array.new<int>(10, 0), flagR = array.new<float>(10, 0.0), sessN = array.new<int>(4, 0), sessR = array.new<float>(4, 0.0))
var array<MtfSetup> mtfSetups = array.new<MtfSetup>()
var int mtfSetupCtr = 0
var array<label> mtfMarks = array.new<label>()
var array<line>  mtfLvls  = array.new<line>()

mtf_mark(label l) =>
    array.push(mtfMarks, l)
    if array.size(mtfMarks) > 120
        label.delete(array.shift(mtfMarks))

mtf_lvl(line l) =>
    array.push(mtfLvls, l)
    if array.size(mtfLvls) > 120
        line.delete(array.shift(mtfLvls))

mtf_num(float v) =>
    na(v) ? "" : str.tostring(v)

// One CSV line per terminal setup state in Pine Logs (copy out for offline analysis).
// Columns: id,dir,state,reason,zone,trigTime,entry,stop,target,exit,R,holdBars,MAE_R,MFE_R,
//          ambiguous,fStruct,fSweep,fPD,fDisp,fCE,session
mtf_log(MtfSetup s) =>
    string tt = na(s.trigTime) ? "" : str.format_time(s.trigTime, "yyyy-MM-dd HH:mm", "America/New_York")
    string hold = na(s.exitBar) or na(s.entryBar) ? "" : str.tostring(s.exitBar - s.entryBar + 1)
    log.info("SETUP," + str.tostring(s.id) + "," + (s.dir == 1 ? "long" : "short") + "," + s.state + "," + s.reason + "," + s.z.tf + " " + s.z.kind + "," + tt + "," + mtf_num(s.entry) + "," + mtf_num(s.stop) + "," + mtf_num(s.target) + "," + mtf_num(s.exitPrice) + "," + mtf_num(s.rMult) + "," + hold + "," + mtf_num(s.mae) + "," + mtf_num(s.mfe) + "," + str.tostring(s.ambiguous) + "," + str.tostring(s.fStruct) + "," + str.tostring(s.fSweep) + "," + str.tostring(s.fPD) + "," + str.tostring(s.fDisp) + "," + str.tostring(s.fCE) + "," + s.session)

mtf_record(MtfStats st, MtfSetup s) =>
    float r = s.rMult
    st.nTrades += 1
    st.sumR += r
    if r > 0
        st.nWins += 1
        st.grossWin += r
    else
        st.grossLoss += -r
    if s.ambiguous
        st.nAmbig += 1
    st.eqR += r
    st.peakR := math.max(st.peakR, st.eqR)
    st.maxDD := math.max(st.maxDD, st.peakR - st.eqR)
    st.sumHold += s.exitBar - s.entryBar + 1
    st.sumMae += s.mae
    st.sumMfe += s.mfe
    array<bool> fl = array.from(s.fStruct, s.fSweep, s.fPD, s.fDisp, s.fCE)
    for k = 0 to 4
        int idx = k * 2 + (array.get(fl, k) ? 0 : 1)
        array.set(st.flagN, idx, array.get(st.flagN, idx) + 1)
        array.set(st.flagR, idx, array.get(st.flagR, idx) + r)
    int si = s.session == "London" ? 0 : s.session == "NY AM" ? 1 : s.session == "NY PM" ? 2 : 3
    array.set(st.sessN, si, array.get(st.sessN, si) + 1)
    array.set(st.sessR, si, array.get(st.sessR, si) + r)

mtf_close(MtfStats st, MtfSetup s, float exitPx, string why, bool limitExit) =>
    s.state     := "Closed"
    s.reason    := why
    s.exitPrice := exitPx
    s.exitBar   := bar_index
    s.rMult     := mtf_rMult(s, exitPx, limitExit)
    MtfZone zz = s.z
    zz.setupLive := false
    zz.lastSetup := "Closed"
    mtf_record(st, s)
    mtf_log(s)
    if mtfShowTrades
        mtf_lvl(line.new(s.entryBar, s.stop, bar_index, s.stop, color = color.new(color.red, 20), style = line.style_dashed))
        mtf_lvl(line.new(s.entryBar, s.target, bar_index, s.target, color = color.new(color.teal, 20), style = line.style_dashed))
        mtf_mark(label.new(bar_index, exitPx, str.tostring(s.rMult, "+#.##;-#.##") + "R " + why, style = label.style_label_left, color = color.new(color.black, 100), textcolor = s.rMult > 0 ? color.teal : color.maroon, size = size.tiny))

mtf_end(MtfStats st, MtfSetup s, string state, string why) =>
    s.state  := state
    s.reason := why
    MtfZone zz = s.z
    zz.setupLive := false
    zz.lastSetup := state == "Rejected" ? "Rejected:" + why : state
    if state == "Expired"
        st.nExpired += 1
    else if state == "Cancelled"
        st.nCancel += 1
    else if why == "risk"
        st.nRejRisk += 1
    else if why == "busy"
        st.nRejBusy += 1
    else
        st.nRejFilt += 1
    mtf_log(s)

// Per-bar engine outputs (consumed by the strategy / alerts).
int   mtfSigDir    = 0
int   mtfSigId     = na
float mtfSigStop   = na
float mtfSigTarget = na
int   mtfArmDir    = 0
int   mtfTimeExitId = na

// Model filters on top of T0. Returns "" if the setup passes, else the name of the failing filter.
// (Phase 4 baseline: no filters.)
mtf_filterFail(MtfSetup s) =>
    ""

if barstate.isconfirmed
    // ---- 1) fills and exits of setups already in flight ----
    for s in mtfSetups
        if s.state == "Triggered" and s.trigBar == bar_index - 1
            s.state     := "Open"
            s.entry     := open
            s.entryBar  := bar_index
            s.entryTime := time
            MtfZone zo = s.z
            zo.lastSetup := "Open"
            // Gap through the stop at the open: the emulator fills entry and stop at the open
            // (mtf_rMult books this as -1R because entry is already beyond the stop).
            if (s.dir == 1 and open <= s.stop) or (s.dir == -1 and open >= s.stop)
                mtf_close(mtfSt, s, open, "GapSL", false)
        if s.state == "Open"
            if s.timeExitPending
                mtf_close(mtfSt, s, open, "TimeExit", false)
            else
                float risk0 = s.dir == 1 ? s.entry - s.stop : s.stop - s.entry
                if risk0 > 0
                    s.mae := math.max(s.mae, (s.dir == 1 ? s.entry - low : high - s.entry) / risk0)
                    s.mfe := math.max(s.mfe, (s.dir == 1 ? high - s.entry : s.entry - low) / risk0)
                bool hitSL = s.dir == 1 ? low <= s.stop : high >= s.stop
                bool hitTP = s.dir == 1 ? high >= s.target : low <= s.target
                if hitSL
                    // Both touched in one bar: path unknown -> counted as a loss (conservative).
                    s.ambiguous := hitTP
                    float px = s.dir == 1 ? math.min(open, s.stop) : math.max(open, s.stop)
                    mtf_close(mtfSt, s, px, "SL", false)
                else if hitTP
                    float px = s.dir == 1 ? math.max(open, s.target) : math.min(open, s.target)
                    mtf_close(mtfSt, s, px, "TP", true)
                else if bar_index - s.entryBar + 1 >= mtfMaxHold
                    s.timeExitPending := true
                    mtfTimeExitId := s.id
    // ---- 2) arm new setups: a valid HTF AOI was touched (price left and came back) ----
    if mtfInWin and mtfInSess
        for z in mtfZonesH
            if z.newTouch and mtf_isAoiZone(z, mtfFlipAOI) and not z.setupLive and z.setupCount < mtfMaxPerZone
                [ok, aTop, aBot] = mtf_aoi(z, mtfAoiMode)
                if ok
                    mtfSetupCtr += 1
                    z.setupCount += 1
                    z.setupLive  := true
                    z.lastSetup  := "Armed"
                    array.push(mtfSetups, MtfSetup.new(id = mtfSetupCtr, z = z, dir = z.dir, aoiTop = aTop, aoiBot = aBot, armBar = bar_index))
                    mtfSt.nArmed += 1
                    mtfArmDir := z.dir
    // ---- 3) armed setups: cancel / trigger / expire ----
    bool busy = false
    for s in mtfSetups
        if s.state == "Triggered" or s.state == "Open"
            busy := true
    for s in mtfSetups
        if s.state == "Armed"
            if s.z.validity != "Active" and s.z.validity != "Flipped"
                mtf_end(mtfSt, s, "Cancelled", "zone " + s.z.validity)
            else if (s.dir == 1 and mtfT0Up) or (s.dir == -1 and mtfT0Dn)
                s.trigBar   := bar_index
                s.trigTime  := time
                s.trigClose := close
                s.session   := mtf_sessBucket(time)
                s.stop      := s.dir == 1 ? s.aoiBot - mtfStopBuf * mtfAtr : s.aoiTop + mtfStopBuf * mtfAtr
                float risk  = s.dir == 1 ? close - s.stop : s.stop - close
                s.target    := s.dir == 1 ? close + mtfTargetR * risk : close - mtfTargetR * risk
                float cost  = mtf_costSide(close, true)
                float rrNet = risk > 0 ? (mtfTargetR * risk - 2 * cost) / (risk + 2 * cost) : -1.0
                string fail = mtf_filterFail(s)
                if fail != ""
                    mtf_end(mtfSt, s, "Rejected", fail)
                else if busy
                    mtf_end(mtfSt, s, "Rejected", "busy")
                else if risk <= 0 or rrNet < mtfMinRR
                    mtf_end(mtfSt, s, "Rejected", "risk")
                else
                    s.state := "Triggered"
                    MtfZone zt = s.z
                    zt.lastSetup := "Triggered"
                    busy := true
                    mtfSigDir    := s.dir
                    mtfSigId     := s.id
                    mtfSigStop   := s.stop
                    mtfSigTarget := s.target
                    if mtfShowTrades
                        mtf_mark(label.new(bar_index, s.dir == 1 ? low : high, (s.dir == 1 ? "▲ BUY #" : "▼ SELL #") + str.tostring(s.id), style = s.dir == 1 ? label.style_label_up : label.style_label_down, color = s.dir == 1 ? color.teal : color.maroon, textcolor = color.white, size = size.small))
            else if bar_index - s.armBar + 1 >= mtfTrigWin
                mtf_end(mtfSt, s, "Expired", "no trigger")
    // ---- 4) drop finished setups; keep stop/target lines of open trades stretched ----
    int nS = array.size(mtfSetups)
    if nS > 0
        for i = nS - 1 to 0
            MtfSetup s = array.get(mtfSetups, i)
            if s.state != "Armed" and s.state != "Triggered" and s.state != "Open"
                array.remove(mtfSetups, i)

// Open trade: temporary stop/target lines up to the current bar.
var array<line> mtfOpenLvls = array.new<line>()
if barstate.islast
    mtf_drawAoiAndPD()
    for l in mtfOpenLvls
        line.delete(l)
    array.clear(mtfOpenLvls)
    if mtfShowTrades
        for s in mtfSetups
            if s.state == "Open"
                array.push(mtfOpenLvls, line.new(s.entryBar, s.stop, bar_index, s.stop, color = color.new(color.red, 20), style = line.style_dashed))
                array.push(mtfOpenLvls, line.new(s.entryBar, s.target, bar_index, s.target, color = color.new(color.teal, 20), style = line.style_dashed))

// ==== ENGINE END (keep in sync) ====

// ============================= MTF ALERTS =============================
// Each setup changes state once, on a closed bar, so each alert fires once per setup ID.
if mtfArmDir != 0
    alert((mtfArmDir == 1 ? "Price entered a BUY AOI (" : "Price entered a SELL AOI (") + syminfo.ticker + ") -- waiting for trigger", alert.freq_once_per_bar_close)
if mtfSigDir != 0
    alert((mtfSigDir == 1 ? "BUY" : "SELL") + " setup #" + str.tostring(mtfSigId) + " triggered on " + syminfo.ticker + ": entry next open, stop " + str.tostring(mtfSigStop, format.mintick) + ", target " + str.tostring(mtfSigTarget, format.mintick), alert.freq_once_per_bar_close)
alertcondition(mtfSigDir == 1, "MTF BUY setup triggered", "MTF BUY setup triggered -- entry next bar open")
alertcondition(mtfSigDir == -1, "MTF SELL setup triggered", "MTF SELL setup triggered -- entry next bar open")
alertcondition(mtfArmDir != 0, "Price entered an AOI", "Price entered an MTF Buy/Sell AOI")

mtf_trendTxt(int t) =>
    t == 1 ? "Up" : t == -1 ? "Down" : "n/a"

// ============================= DASHBOARD TABLE =============================
var table dash = table.new(position.top_right, 2, 24, border_width = 1, bgcolor = color.new(color.black, 20))

if barstate.islast
    table.cell(dash, 0, 0, "COT Net", text_color = color.white)
    table.cell(dash, 1, 0, na(cotNet) ? "off" : str.tostring(math.round(cotNet)), text_color = color.white)

    table.cell(dash, 0, 1, "COT Index", text_color = color.white)
    table.cell(dash, 1, 1, na(cotIndex) ? "n/a" : str.tostring(math.round(cotIndex)),
         text_color = (not na(cotIndex) and (cotIndex >= 90 or cotIndex <= 10)) ? color.yellow : color.white)

    table.cell(dash, 0, 2, "Cum Delta", text_color = color.white)
    table.cell(dash, 1, 2, str.tostring(math.round(cumDelta)), text_color = cumDelta >= 0 ? color.teal : color.maroon)

    table.cell(dash, 0, 3, "POC (approx)", text_color = color.white)
    table.cell(dash, 1, 3, na(pocPriceOut) ? "n/a" : str.tostring(pocPriceOut, format.mintick), text_color = color.orange)

    table.cell(dash, 0, 4, "Bin Size", text_color = color.white)
    table.cell(dash, 1, 4, str.tostring(effectiveRowSize, format.mintick) + (autoBinSize ? " (auto)" : " (manual)"), text_color = color.gray)

    table.cell(dash, 0, 5, "Active FVGs", text_color = color.white)
    table.cell(dash, 1, 5, str.tostring(bullFvgCount) + " bull / " + str.tostring(bearFvgCount) + " bear", text_color = color.gray)

    table.cell(dash, 0, 6, "Active S/D Zones", text_color = color.white)
    table.cell(dash, 1, 6, str.tostring(supplyCount) + " sup / " + str.tostring(demandCount) + " dem", text_color = color.gray)

    table.cell(dash, 0, 7, "Active Order Blocks", text_color = color.white)
    table.cell(dash, 1, 7, str.tostring(bullObCount) + " bull / " + str.tostring(bearObCount) + " bear", text_color = color.gray)

    table.cell(dash, 0, 8, "MS Trend", text_color = color.white)
    table.cell(dash, 1, 8, msTrend == 1 ? "Up" : msTrend == -1 ? "Down" : "n/a", text_color = msTrend == 1 ? color.teal : msTrend == -1 ? color.maroon : color.gray)

    table.cell(dash, 0, 9, "LRL (approx.)", text_color = color.white)
    table.cell(dash, 1, 9, "up " + str.tostring(obstaclesAbove) + " / dn " + str.tostring(obstaclesBelow), text_color = color.gray)

    table.cell(dash, 0, 10, "Last CISD", text_color = color.white)
    table.cell(dash, 1, 10, cisdLastOut, text_color = cisdLastOut == "Bullish" ? color.aqua : cisdLastOut == "Bearish" ? color.maroon : color.gray)

    // ---- MTF engine rows ----
    table.cell(dash, 0, 11, "TF  LTF / Chart / HTF", text_color = color.white)
    table.cell(dash, 1, 11, mtfLtfName + " / " + mtfCtfName + " / " + mtfHtfName, text_color = color.gray)

    table.cell(dash, 0, 12, "Trend  LTF / Chart / HTF", text_color = color.white)
    table.cell(dash, 1, 12, mtf_trendTxt(mtfLtfTrend) + " / " + mtf_trendTxt(cTrend) + " / " + mtf_trendTxt(mtfHtfTrend), text_color = color.gray)

    string alignTxt = mtfHtfTrend == 1 and cTrend == 1 and (not mtfLtfOn or mtfLtfTrend == 1) ? "Aligned Bull" : mtfHtfTrend == -1 and cTrend == -1 and (not mtfLtfOn or mtfLtfTrend == -1) ? "Aligned Bear" : "Mixed"
    table.cell(dash, 0, 13, "Alignment", text_color = color.white)
    table.cell(dash, 1, 13, alignTxt, text_color = alignTxt == "Aligned Bull" ? color.teal : alignTxt == "Aligned Bear" ? color.maroon : color.gray)

    table.cell(dash, 0, 14, "Zones  LTF / Chart / HTF", text_color = color.white)
    table.cell(dash, 1, 14, str.tostring(array.size(mtfZonesL)) + " / " + str.tostring(array.size(mtfZonesC)) + " / " + str.tostring(array.size(mtfZonesH)), text_color = color.gray)

    table.cell(dash, 0, 15, "Newest HTF zone", text_color = color.white)
    table.cell(dash, 1, 15, array.size(mtfZonesH) > 0 ? mtf_zoneTxt(array.last(mtfZonesH)) : "none", text_color = color.gray)

    table.cell(dash, 0, 16, "Location (HTF range)", text_color = color.white)
    table.cell(dash, 1, 16, mtf_pdTxt(close) + (na(mtfEq) ? "" : "  EQ " + str.tostring(mtfEq, format.mintick)), text_color = mtf_pdTxt(close) == "Disc" ? color.teal : mtf_pdTxt(close) == "Prem" ? color.maroon : color.gray)

    table.cell(dash, 0, 17, "Setups armed / closed", text_color = color.white)
    table.cell(dash, 1, 17, str.tostring(mtfSt.nArmed) + " / " + str.tostring(mtfSt.nTrades) + "  (exp " + str.tostring(mtfSt.nExpired) + ", rej " + str.tostring(mtfSt.nRejFilt + mtfSt.nRejRisk + mtfSt.nRejBusy) + ", canc " + str.tostring(mtfSt.nCancel) + ")", text_color = color.gray)

    table.cell(dash, 0, 18, "Ledger (net R)", text_color = color.white)
    table.cell(dash, 1, 18, mtfSt.nTrades == 0 ? "no trades" : str.tostring(mtfSt.nTrades) + " trades, exp " + str.tostring(mtfSt.sumR / mtfSt.nTrades, "#.##") + "R, maxDD " + str.tostring(mtfSt.maxDD, "#.#") + "R", text_color = mtfSt.sumR >= 0 ? color.teal : color.maroon)

    if mtfLtfMissing > 0
        table.cell(dash, 0, 22, "LTF bars w/o intrabars", text_color = color.white)
        table.cell(dash, 1, 22, str.tostring(mtfLtfMissing), text_color = color.gray)

    if mtfWarn != ""
        table.cell(dash, 0, 23, "Warning", text_color = color.yellow)
        table.cell(dash, 1, 23, mtfWarn, text_color = color.yellow)
